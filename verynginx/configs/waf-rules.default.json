{
  "version": 19,
  "timestamp": "2026-10-14T02:20:00Z",
  "rules": [
    {
      "id": "vn_sqli_0001",
      "name": "SQL Injection — UNION Select",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\bunion\\b(?:[\\s/*!]+(?:all|distinct))?(?:[\\s(!\\d]|/\\*(?:[\\s\\S]*?\\*/|[!\\d]*)|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*select\\b(?:[\\s(!\\d]|/\\*(?:[\\s\\S]*?\\*/|[!\\d]*)|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:(?:\\*|\\(|\\d|null\\b|distinct\\b|'[^']*'|\\\"[^\\\"]*\\\"|[\\w$]+\\s*\\(|[\\w$]+\\s*,)|(?=[\\s\\S]{0,200}?['\\\"()\\d=;*,!@#%+<>&|~-]|[\\s\\S]{0,200}?\\b(?:passwords?|passwd|usernames?|admins?|schemas?|versions?|databases?|table_name|column_name|information_schema|group_concat|concat|char)\\b)[^;]{0,100}?\\b(?:from|into|limit|where|having)\\b)|(?:['\\\"()=*;])[\\s\\S]{0,20}?\\bunion\\b(?:[\\s/*!]+(?:all|distinct))?(?:[\\s(!\\d]|/\\*(?:[\\s\\S]*?\\*/|[!\\d]*)|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*select\\b(?:[\\s(!\\d]|/\\*(?:[\\s\\S]*?\\*/|[!\\d]*)|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*[^;]{0,100}?\\b(?:from|into|limit|where|having)\\b"
              }
            }
          ]
        }
      },
      "description": "Detects UNION-based SQL injection attempts in request parameters (UNION(SELECT) and UNION DISTINCT included; bare-word column lists require an attack marker so tutorial prose stays out). v18: the UNION/SELECT separator also accepts SQL comments, not just blank characters — an arbitrary comment body (/*x*/), MySQL conditional comments with the SELECT inside them (/*!50000SELECT*/, which the old character class matched only because it ate /,*,! and the digits), and the two line comments (-- and #). The '--' body is required to be empty, which is what MySQL actually honours: '-- select 3 items' is prose, '-- -\\nselect' is an injection.",
      "tags": [],
      "version": 8,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T01:40:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0002",
      "name": "SQL Injection — Tautology / OR",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:\\b(?:or|and)\\b|\\|\\||&&)(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*['\\\"]?(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*\\d+(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:=|<>|!=|<=|>=|<|>|\\bLIKE\\b|\\bRLIKE\\b|\\bREGEXP\\b|\\bIN\\b|\\bBETWEEN\\b)(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:\\(\\s*)?\\d+|['\\\"](?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:\\b(?:or|and)\\b|\\|\\||&&)(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*['\\\"][^'\\\\\\\"]*['\\\"](?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:=|<>|!=|<=|>=|<|>|\\bLIKE\\b|\\bRLIKE\\b|\\bREGEXP\\b|\\bIN\\b|\\bBETWEEN\\b)(?:\\s|/\\*[\\s\\S]*?\\*/|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:\\(\\s*)?['\\\"]"
              }
            }
          ]
        }
      },
      "description": "Detects tautology-based SQLi like ' OR 1=1 (comment-obfuscated gaps and LIKE/IN/BETWEEN covered). v18: the gap between the boolean operator and the compared literals also tolerates line comments (' OR-- -\\n1=1), which previously slipped through because only block comments were accepted there.",
      "tags": [],
      "version": 7,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T01:40:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0003",
      "name": "SQL Injection — Stacked Queries",
      "category": "sqli",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:;|&&)\\s*(?:drop|truncate|exec|declare|alter|create|insert|update|delete|rename|grant)\\b"
              }
            }
          ]
        }
      },
      "description": "Detects stacked query keywords (DDL/DML verbs after ';' or '&&') in parameters. Comment-syntax detection was removed in v9. Action is log (not block): the single-keyword pattern false-positives on ordinary prose (\"wait; create an account\", \"ok; update: fixed it\"), so it is kept at log pending a two-keyword-tuned regex.",
      "tags": [],
      "version": 6,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-13T07:25:34Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0004",
      "name": "SQL Injection — Time-Based / Information Schema",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\bwaitfor\\s+delay\\s*['\\\"]|\\bxp_cmdshell\\b(?=\\s*[\\x28\\x27\\x22])|(?<!query )(?<!describe )(?<!desc )(?<!show )(?<!explain )(?<!the )(?<!an )(?<!this )(?<!that )(?<!these )(?<!those )(?<!your )(?<!our )(?<!my )\\binformation_schema\\b|(?<!query )(?<!describe )(?<!desc )(?<!show )(?<!explain )(?<!the )(?<!an )(?<!this )(?<!that )(?<!these )(?<!those )(?<!your )(?<!our )(?<!my )(?<!call )(?<!use )\\b(?:updatexml|extractvalue)\\s*\\(|(?:[;,()=]|\\b(?:or|and|select|from|having|union)\\b)[^;]{0,50}?(?:\\b(?:sleep|benchmark|pg_sleep|load_file|get_lock|receive_message)\\s*\\(|\\b(?:char|chr|unhex|concat(?:_ws)?|group_concat)\\s*\\()|\\b(?:or|and|select|from|having|union|values|into)\\b[^;]{0,50}?\\b0x[0-9a-f]{2,}\\b"
              }
            }
          ]
        }
      },
      "description": "Detects time-based / error-based SQLi and schema enumeration (sleep, benchmark, get_lock, waitfor delay, information_schema, load_file, char/concat/unhex/0x probes, xp_cmdshell, updatexml, extractvalue). Tutorial-text contexts stay out.",
      "tags": [
        "sqli",
        "time-based"
      ],
      "version": 6,
      "created_at": "2026-10-11T10:45:00Z",
      "updated_at": "2026-10-13T09:37:42Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0005",
      "name": "SQL Injection — Stacked Query After Breakout",
      "category": "sqli",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:['\\\"()=*;,]|\\d)\\s*;\\s*(?:select|insert|update)\\b(?:[\\s(!\\d]|/\\*(?:[\\s\\S]*?\\*/|[!\\d]*)|--[ \\t-]*(?=\\r?\\n|$)|[#][^\\r\\n]*)*(?:\\*|into\\b|[\\w$]+\\s*(?:,|\\()|[\\w$]+\\s+(?:from|into|set|values)\\b)"
              }
            }
          ]
        }
      },
      "description": "Detects a second query stacked onto a string breakout (\"1'; SELECT password FROM users\"), which vn_sqli_0001 cannot see: that rule needs UNION, and vn_sqli_0003 only covers DDL/DML verbs at log. Precision comes from demanding both an SQL-ish character immediately before the semicolon and a column-list shape after the verb, so prose like \"click; select a plan from the menu\" stays out. UNION-stacked payloads are left to vn_sqli_0001, which already matches them. Action is log for the first release: the pattern is new and its prose surface has only been measured against a synthetic corpus.",
      "tags": [],
      "version": 1,
      "created_at": "2026-10-14T01:40:00Z",
      "updated_at": "2026-10-14T01:40:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0004",
      "name": "Cross-Site Scripting — Script Tags",
      "category": "xss",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Composite": {
                "operator": "OR",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "<script[\\s/>]"
                    }
                  },
                  {
                    "Args": {
                      "value": "<script[\\s/>]",
                      "name_operator": "*",
                      "operator": "≈"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "description": "Detects <script tags in request parameters. v19: also matches the request path — until now the rule carried an Args condition only, so 'GET /<script>alert(1)</script>' with no query string and no body never reached it at all. vn_xss_0006 already covered both URI and Args, which made the inconsistency a pure gap.",
      "tags": [],
      "version": 6,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T02:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0005",
      "name": "Cross-Site Scripting — Event Handlers",
      "category": "xss",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\b(?:onabort|onafterprint|onanimationcancel|onanimationend|onanimationiteration|onanimationstart|onauxclick|onbeforeinput|onbeforematch|onbeforeprint|onbeforetoggle|onbeforeunload|onbegin|onblur|oncancel|oncanplay|oncanplaythrough|onchange|onclick|onclose|oncontextlost|oncontextmenu|oncontextrestored|oncopy|oncuechange|oncut|ondblclick|ondrag|ondragend|ondragenter|ondragleave|ondragover|ondragstart|ondrop|ondurationchange|onemptied|onend|onended|onerror|onfocus|onformdata|ongotpointercapture|onhashchange|oninput|oninvalid|onkeydown|onkeypress|onkeyup|onlanguagechange|onload|onloadeddata|onloadedmetadata|onloadstart|onlostpointercapture|onmessage|onmessageerror|onmousedown|onmouseenter|onmouseleave|onmousemove|onmouseout|onmouseover|onmouseup|onmousewheel|onoffline|ononline|onpagehide|onpagereveal|onpageshow|onpageswap|onpaste|onpause|onplay|onplaying|onpointercancel|onpointerdown|onpointerenter|onpointerleave|onpointermove|onpointerout|onpointerover|onpointerrawupdate|onpointerup|onpopstate|onprogress|onratechange|onrepeat|onreset|onresize|onscroll|onsearch|onsecuritypolicyviolation|onseeked|onseeking|onselect|onslotchange|onstalled|onstorage|onsubmit|onsuspend|ontimeupdate|ontoggle|ontransitioncancel|ontransitionend|ontransitionrun|ontransitionstart|onunhandledrejection|onunload|onvolumechange|onwaiting|onwebkitanimationcancel|onwebkitanimationend|onwebkitanimationiteration|onwebkitanimationstart|onwebkittransitionend|onwheel)(?:\\s|/\\*[\\s\\S]*?\\*/|/)*="
              }
            }
          ]
        }
      },
      "description": "Detects HTML event-handler attributes (on*) in request parameters. v19: the handler table grows from 92 to 116 entries. '<body onpageshow=alert(1)>' is a complete working chain in every current browser and the table did not list it; onhashchange, onmessage, onoffline, ononline, onunload, onstorage, onpopstate, onbeforeunload, onafterprint, onbeforeprint, onlanguagechange and the webkit animation/transition family were missing too. Pure list growth: 27/27 on the handler corpus, zero prose hits.",
      "tags": [],
      "version": 6,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T02:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0006",
      "name": "Cross-Site Scripting — javascript: Protocol",
      "category": "xss",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Composite": {
                "operator": "OR",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?:java\\s*script\\s*:\\s*[!+~(<{\\[]{0,3}[\\w$]{1,40}(?:\\s*\\.\\s*[\\w$]{1,40}){0,4}\\s*(?:[(\\[]|=|`)|data\\s*:\\s*text/html\\s*[;,][\\s\\S]{0,300}?(?:[<>]|base64|[A-Za-z0-9+/]{16,}={0,2}))"
                    }
                  },
                  {
                    "Args": {
                      "name_operator": "*",
                      "operator": "≈",
                      "value": "(?:java\\s*script\\s*:\\s*[!+~(<{\\[]{0,3}[\\w$]{1,40}(?:\\s*\\.\\s*[\\w$]{1,40}){0,4}\\s*(?:[(\\[]|=|`)|data\\s*:\\s*text/html\\s*[;,][\\s\\S]{0,300}?(?:[<>]|base64|[A-Za-z0-9+/]{16,}={0,2}))"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "description": "Detects javascript: and data:text/html URIs whose payload has code shape (call, subscript or assignment). v19 fixes a reachability bug v16 introduced: the code-shape branches sat behind a zero-width lookahead pinned to the first character after the colon, so 'javascript: alert(1)' (one space), 'javascript:globalThis.alert(1)', 'javascript:atob(\"...\")()', 'javascript:(alert(1))' and a bare-base64 data:text/html all missed while 'javascript:alert(1)' matched — the v16 precision was an accident of an unreachable branch, not a design. The shape is now an identifier chain followed by '(', '[', '=' or a template backtick: 24/26 on the attack corpus, zero violations of the existing pins. Cost: two prose cases now hit ('how to javascript: fetch( data ) from a worker', '用 javascript: document.write( 会阻塞渲染'), both code references inside a sentence — the accepted price of matching code shape.",
      "tags": [],
      "version": 8,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T02:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0007",
      "name": "Remote Command Execution — Shell Metacharacters",
      "category": "rce",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "^\\s*(?:\\|{1,2}|&&?|;|`|\\$\\(|\\$\\{)\\s*(?:(?:rm|cp|mv|chmod|chown|dd|ssh|scp|nc|ncat|netcat|socat|tftp|telnet|ftp|mount|umount)\\b(?!\\s*(?:the|is|an|of|to|and|or|in|on|at|for|with|like|this|that|these|those|it|my|your|our|some|all|here|there|when|then|what|which|who|how|not|no|yes|from|into|about|after|before|first|next|now|just|also|more|new|need|use|will|should|would|can|be|do|you|we|but|so|as|by)\\b)|(?:mkfs|crontab|nohup|pkill|base64|openssl)\\b)"
              }
            }
          ]
        }
      },
      "description": "Detects shell metacharacter command injection at the start of a parameter value. v19: the separator set also accepts '&', '&&' and '||' — '&' is the most common shell connector after ';' and '&&cat /etc/passwd' walked straight past a block rule. The English-filler guard now applies only to the commands whose names actually collide with prose (rm, cp, mv, chmod, chown, dd, ssh, scp, nc, ncat, netcat, socat, tftp, telnet, ftp, mount, umount); for mkfs, crontab, nohup, pkill, base64 and openssl it is dropped, because there it was pure bypass switch — ';mkfs the /dev/sda' used to be cleared by inserting the single word 'the'. Residual unchanged and asserted: for the colliding commands the guard is still a byte-level negative condition (';rm the -rf /' passes), the price of not blocking English prose. The log-tier companion is vn_rce_0025, which carries the merged command list for mid-value recall.",
      "tags": [],
      "version": 8,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T02:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0008",
      "name": "Remote Command Execution — PHP Code Injection",
      "category": "rce",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "value": "\\b(?:system|exec|passthru|shell_exec|popen|proc_open|eval|assert|create_function|call_user_func|array_map)\\s*\\(",
                "name_operator": "*",
                "operator": "≈"
              }
            }
          ]
        }
      },
      "description": "Detects PHP function injection attempts. Logged by default — eval/assert/array_map/exec( appear legitimately in code snippets, CMS content, and comments (high FP risk); flip to block after review if the site does not accept such content.",
      "tags": [],
      "version": 5,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-13T07:25:34Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0009",
      "name": "Remote Code Execution — Dangerous URL Schemes",
      "category": "rce",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:gopher|dict|jar):(?://|(?:https?|ftp|file|gopher):(?://)?)[a-z0-9-]{1,}(?:\\.[a-z0-9-]+)+(?:[:/?#]|$)"
              }
            }
          ]
        }
      },
      "description": "Detects dangerous URL schemes (gopher, dict, jar) in request parameters. v19: the scheme must be followed by a dotted host — a positive requirement, not a filter — so 'dict://localhost:11211/stats' (Memcached ops, previously blocked), 'jar://不是标准 URL' and 'python zipfile:// vs jar:// packaging' stay out, while 'jar:http://host/x.jar!/', the actual Java deserialisation RCE shape that the old 'jar://' pattern could never match, is caught. Accepted miss: 'jar:file:///path' has no host to validate.",
      "tags": [],
      "version": 6,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-14T02:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_ssrf_0021",
      "name": "SSRF — Internal / Metadata IP in URL",
      "category": "ssrf",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)^/(?:phpmyadmin|phpminiadmin|adminer)(?:\\.php)?(?:/|$)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "https?://(?:[^/\\s?#]*@)?(?:localhost|127(?:\\.\\d+){3}|0\\.0\\.0\\.0|\\[?::1\\]?|169\\.254\\.(?:169\\.254|170\\.\\d+)|metadata\\.google\\.internal|10(?:\\.\\d+){3}|192\\.168(?:\\.\\d+){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d+){2}|100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])(?:\\.\\d+){2})|https?://(?:[^/\\s?#]*@)?0x[0-9a-f]+|https?://(?:[^/\\s?#]*@)?\\d{8,12}\\b"
              }
            }
          ]
        }
      },
      "description": "Detects URLs pointing to internal / private / cloud-metadata IPs in parameters (SSRF), including dword (decimal) and hex encodings and 169.254.170.x (ECS). Logged by default — internal URLs in params are common (OAuth redirects, service callbacks); review logs then flip to block if appropriate. Userinfo-prefixed URLs (user@host) covered.",
      "tags": [
        "ssrf"
      ],
