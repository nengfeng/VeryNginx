                  {
                    "Header": {
                      "name_operator": "≈",
                      "name_value": "(?i)content-type",
                      "operator": "≈",
                      "value": "(?i)multipart/form-data"
                    }
                  }
                ]
              }
            },
            {
              "Composite": {
                "operator": "NOT",
