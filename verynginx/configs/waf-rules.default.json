{
  "version": 9,
  "timestamp": "2026-10-10T20:22:16Z",
  "rules": [
    {
      "id": "vn_sqli_0001",
      "name": "SQL Injection — UNION Select",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 100,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "Header": {
                      "name_operator": "≈",
                      "name_value": "(?i)content-type",
                      "operator": "≈",
                      "value": "(?i)multipart/form-data"
                    }
                  }
                ]
              }
            },
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpMyAdmin|myadmin|pma|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\bunion\\b(?:[\\s/*]+all)?[\\s/*]*select\\b[\\s/*]*(?:\\*|\\(|\\d|null\\b|distinct\\b|'[^']*'|\\\"[^\\\"]*\\\"|[^;]{0,100}?\\bfrom\\b)"
              }
            }
          ]
        }
      },
      "description": "Detects UNION-based SQL injection attempts in request parameters",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0002",
      "name": "SQL Injection — Tautology / OR",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 100,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "Header": {
                      "name_operator": "≈",
                      "name_value": "(?i)content-type",
                      "operator": "≈",
                      "value": "(?i)multipart/form-data"
                    }
                  }
                ]
              }
            },
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpMyAdmin|myadmin|pma|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\b(?:or|and)\\b\\s*['\\\"]?\\d+['\\\"]?\\s*[=<>]|['\\\"]\\s*(?:or|and)\\s*['\\\"][^'\\\"]*['\\\"]\\s*[=<>]\\s*['\\\"]"
              }
            }
          ]
        }
      },
      "description": "Detects tautology-based SQLi like ' OR 1=1",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0003",
