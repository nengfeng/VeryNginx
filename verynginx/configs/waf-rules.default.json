{
  "version": 10,
  "timestamp": "2026-10-11T10:45:00Z",
  "rules": [
    {
      "id": "vn_sqli_0001",
      "name": "SQL Injection — UNION Select",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\bunion\\b(?:[\\s/*]+all)?[\\s/*]*select\\b[\\s/*]*(?:\\*|\\(|\\d|null\\b|distinct\\b|'[^']*'|\\\"[^\\\"]*\\\"|[^;]{0,100}?\\bfrom\\b)"
              }
            }
          ]
        }
      },
      "description": "Detects UNION-based SQL injection attempts in request parameters",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0002",
      "name": "SQL Injection — Tautology / OR",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\b(?:or|and)\\b\\s*['\\\"]?\\d+['\\\"]?\\s*[=<>]|['\\\"]\\s*(?:or|and)\\s*['\\\"][^'\\\"]*['\\\"]\\s*[=<>]\\s*['\\\"]"
              }
            }
          ]
        }
      },
      "description": "Detects tautology-based SQLi like ' OR 1=1",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0003",
      "name": "SQL Injection — Comments / Stacked Queries",
      "category": "sqli",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:;|&&)\\s*(?:drop|truncate|exec|declare|alter|create|insert|update|delete|rename|grant)\\b"
              }
            }
          ]
        }
      },
      "description": "Detects SQL comments and stacked query keywords. Action is log (not block): the single-keyword pattern after ';'/'&&' false-positives on ordinary prose (\"wait; create an account\", \"ok; update: fixed it\"), so it is kept at log pending a two-keyword-tuned regex.",
      "tags": [],
      "version": 3,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-12T00:20:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_sqli_0004",
      "name": "SQL Injection — Time-Based / Information Schema",
      "category": "sqli",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\b(?:sleep|benchmark)\\s*\\(|\\bwaitfor\\s+delay\\b|\\binformation_schema\\b|\\bload_file\\s*\\(|\\bxp_cmdshell\\b|\\b(?:updatexml|extractvalue)\\s*\\("
              }
            }
          ]
        }
      },
      "description": "Detects time-based / error-based SQLi and schema enumeration (sleep, benchmark, waitfor delay, information_schema, load_file, xp_cmdshell, updatexml, extractvalue)",
      "tags": [
        "sqli",
        "time-based"
      ],
      "version": 1,
      "created_at": "2026-10-11T10:45:00Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0004",
      "name": "Cross-Site Scripting — Script Tags",
      "category": "xss",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "value": "<script[\\s>]",
                "name_operator": "*",
                "operator": "≈"
              }
            }
          ]
        }
      },
      "description": "Detects <script> tag injection in parameters",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0005",
      "name": "Cross-Site Scripting — Event Handlers",
      "category": "xss",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\b(?:onerror|onload|onclick|onmouseover|onmouseout|onmousedown|onmouseup|onfocus|onblur|onchange|onsubmit|onreset|onselect|onkeydown|onkeyup|onkeypress|oninput|ontoggle|onanimationstart|ontransitionstart)\\s*="
              }
            }
          ]
        }
      },
      "description": "Detects HTML/JS event handler injection (onload, onerror, onclick, etc.)",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_xss_0006",
      "name": "Cross-Site Scripting — javascript: Protocol",
      "category": "xss",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "OR",
          "conditions": [
            {
              "URI": {
                "operator": "≈",
                "value": "javascript\\s*:\\s*(?:alert|confirm|prompt|document\\.|window\\.|location\\.)"
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "javascript\\s*:\\s*(?:alert|confirm|prompt|document\\.|window\\.|location\\.)"
              }
            }
          ]
        }
      },
      "description": "Detects javascript: XSS payload in URI or parameters (javascript:alert/confirm/prompt/document./window./location.)",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0007",
      "name": "Remote Command Execution — Shell Metacharacters",
      "category": "rce",
      "severity": "critical",
      "action": "block",
      "enable": true,
      "priority": 10,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:\\||;|`|\\$\\(|\\$\\{)\\s*\\b(?:cmd|powershell|bash|sh|zsh|python[0-9.]*|perl|wget|curl|nc|ncat)\\b"
              }
            }
          ]
        }
      },
      "description": "Detects shell metacharacters in parameters indicating command injection",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0008",
      "name": "Remote Command Execution — PHP Code Injection",
      "category": "rce",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "value": "\\b(?:system|exec|passthru|shell_exec|popen|proc_open|eval|assert|create_function|call_user_func|array_map)\\s*\\(",
                "name_operator": "*",
                "operator": "≈"
              }
            }
          ]
        }
      },
      "description": "Detects PHP function injection attempts. Logged by default — eval/assert/array_map/exec( appear legitimately in code snippets, CMS content, and comments (high FP risk); flip to block after review if the site does not accept such content.",
      "tags": [],
      "version": 3,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_rce_0009",
      "name": "Remote Code Execution — Dangerous URL Schemes",
      "category": "rce",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:gopher|dict|jar)://"
              }
            }
          ]
        }
      },
      "description": "Detects gopher://, dict://, jar:// URL schemes in parameters (SSRF / remote inclusion). These schemes have no legitimate web use. Internal-IP SSRF is split out to vn_ssrf_0021 (logged) to avoid false-positives on OAuth redirects / callbacks.",
      "tags": [],
      "version": 3,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_ssrf_0021",
      "name": "SSRF — Internal / Metadata IP in URL",
      "category": "ssrf",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "https?://(?:localhost|127(?:\\.\\d+){3}|0\\.0\\.0\\.0|\\[?::1\\]?|169\\.254\\.(?:169\\.254|170\\.\\d+)|metadata\\.google\\.internal|10(?:\\.\\d+){3}|192\\.168(?:\\.\\d+){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d+){2}|100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])(?:\\.\\d+){2})|https?://0x[0-9a-f]+|https?://\\d{8,12}\\b"
              }
            }
          ]
        }
      },
      "description": "Detects URLs pointing to internal / private / cloud-metadata IPs in parameters (SSRF), including dword (decimal) and hex encodings and 169.254.170.x (ECS). Logged by default — internal URLs in params are common (OAuth redirects, service callbacks); review logs then flip to block if appropriate.",
      "tags": [
        "ssrf"
      ],
      "version": 1,
      "created_at": "2026-10-11T10:45:00Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_lfi_0010",
      "name": "Local File Inclusion — Sensitive Files",
      "category": "lfi",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "OR",
          "conditions": [
            {
              "URI": {
                "operator": "≈",
                "value": "(?:etc/passwd|etc/shadow|etc/hosts|proc/self/environ|proc/self/cmdline|boot\\.ini|win\\.ini)"
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "(?:etc/passwd|etc/shadow|etc/hosts|proc/self/environ|proc/self/cmdline|boot\\.ini|win\\.ini)"
              }
            }
          ]
        }
      },
      "description": "Detects attempts to read sensitive system files",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_lfi_0011",
      "name": "Local File Inclusion — PHP Wrappers",
      "category": "lfi",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "AND",
          "conditions": [
            {
              "Composite": {
                "operator": "NOT",
                "conditions": [
                  {
                    "URI": {
                      "operator": "≈",
                      "value": "(?i)/(?:phpmyadmin|phpminiadmin|adminer)(?:/|$|\\.)"
                    }
                  }
                ]
              }
            },
            {
              "Args": {
                "value": "php://|file://|expect://|data://|input://",
                "name_operator": "*",
                "operator": "≈"
              }
            }
          ]
        }
      },
      "description": "Detects PHP stream wrapper usage for LFI",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_path_traversal_0012",
      "name": "Path Traversal — Directory Escape",
      "category": "path_traversal",
      "severity": "high",
      "action": "block",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Composite": {
          "operator": "OR",
          "conditions": [
            {
              "URI": {
                "operator": "≈",
                "value": "\\.\\./|\\.\\.\\\\|%2e%2e%2f|%2e%2e\\\\|..%5c"
              }
            },
            {
              "Args": {
                "name_operator": "*",
                "operator": "≈",
                "value": "\\.\\./|\\.\\.\\\\|%2e%2e%2f|%2e%2e\\\\|..%5c"
              }
            }
          ]
        }
      },
      "description": "Detects directory traversal sequences (../) encoding bypasses included",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_path_traversal_0013",
      "name": "Path Traversal — Absolute Windows Path",
      "category": "path_traversal",
      "severity": "medium",
      "action": "block",
      "enable": true,
      "priority": 30,
      "matcher": {
        "URI": {
          "operator": "≈",
          "value": "(?:\\b[a-zA-Z]:[/\\\\])"
        }
      },
      "description": "Detects absolute Windows paths in request URI",
      "tags": [],
      "version": 1,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-06-29T04:48:04Z",
      "created_by": "system"
    },
    {
      "id": "vn_scanner_0014",
      "name": "Scanner — Known Security Tools",
      "category": "scanner",
      "severity": "medium",
      "action": "block",
      "enable": true,
      "priority": 30,
      "matcher": {
        "UserAgent": {
          "operator": "≈",
          "value": "(?i:(?:acunetix|netsparker|nessus|nikto|openvas|w3af|appscan|burpsuite|zap\\b|arachni|grendel|webinspect|nmap|sqlmap|hydra|medusa|ncrack|thc))"
        }
      },
      "description": "Blocks requests from known security scanning tools",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_scanner_0015",
      "name": "Scanner — Vulnerability Scanner Paths",
      "category": "scanner",
      "severity": "medium",
      "action": "block",
      "enable": true,
      "priority": 30,
      "matcher": {
        "URI": {
          "operator": "≈",
          "value": "(?:/manager/html|/jmx-console|/actuator|/cgi-bin/|/~root|/~admin)"
        }
      },
      "description": "Blocks scanner-targeted management paths (Tomcat manager, JMX console, Spring actuator, CGI bin, home dirs). CMS admin paths (/wp-admin, /administrator) and the overly-broad /console are intentionally NOT blocked for LNMP compatibility.",
      "tags": [],
      "version": 3,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_bot_0016",
      "name": "Malicious Bot — Aggressive Crawlers",
      "category": "bot",
      "severity": "low",
      "action": "block",
      "enable": true,
      "priority": 40,
      "matcher": {
        "UserAgent": {
          "operator": "≈",
          "value": "(?i:(?:semrush|ahrefs|majestic|mj12|dotbot|rogerbot|exabot|ltx71|turnitin))"
        }
      },
      "description": "Blocks known aggressive/commercial crawlers that ignore robots.txt",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
    {
      "id": "vn_bot_0017",
      "name": "Malicious Bot — Scraper / Harvester",
      "category": "bot",
      "severity": "low",
      "action": "block",
      "enable": true,
      "priority": 40,
      "matcher": {
        "UserAgent": {
          "operator": "≈",
          "value": "(?i:(?:dataforseo|ccbot|mauibot|claudebot|brightbot|scrapy))"
        }
      },
      "description": "Blocks known AI/SEO scrapers and harvesters. Generic HTTP tool UAs (curl, wget, python-requests, go-http-client) are intentionally NOT blocked by default to avoid breaking health checks, CI, and service-to-service calls.",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_brute_0018",
      "name": "Brute Force — Login Path Protection",
      "category": "brute",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "URI": {
          "operator": "≈",
          "value": "(?:/login|/signin|/auth|/wp-login)(?:[/?#.]|$)"
        }
      },
      "description": "Monitors login endpoints for brute force attempts; rate-limit recommended",
      "tags": [
        "brute",
        "rate-limit"
      ],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_spam_0019",
      "name": "Spam Referrer — Known Spam Domains",
      "category": "spam",
      "severity": "low",
      "action": "block",
      "enable": true,
      "priority": 40,
      "matcher": {
        "Referer": {
          "operator": "≈",
          "value": "(?:https?:)?//[^/\\s]*(?:shoes-online|pills|casino|viagra|cialis)[^/\\s]*"
        }
      },
      "description": "Blocks requests with known spam referrer domains",
      "tags": [],
      "version": 3,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-11T10:45:00Z",
      "created_by": "system"
    },
    {
      "id": "vn_custom_0020",
      "name": "Sensitive Files — Environment & Config",
      "category": "custom",
      "severity": "medium",
      "action": "block",
      "enable": true,
      "priority": 30,
      "matcher": {
        "URI": {
          "operator": "≈",
          "value": "/(?:\\.env|\\.git/config|\\.svn/entries|\\.DS_Store|composer\\.json|package\\.json|credentials\\.(?:json|ya?ml|txt|bak|csv|conf|ini|env|pem|key|p12|inc|php)|config\\.php|config\\.inc)|\\.(?:bak|old|save|swp|tar\\.gz|sql\\.gz|htaccess|htpasswd|bash_history|ssh)$"
