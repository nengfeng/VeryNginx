      "description": "Blocks access to common sensitive/admin paths targeted by scanners (excludes /phpmyadmin for LNMP compatibility)",
      "tags": [],
      "version": 2,
      "created_at": "2026-06-29T04:48:04Z",
      "updated_at": "2026-10-10T20:22:16Z",
      "created_by": "system"
    },
