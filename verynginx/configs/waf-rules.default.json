    {
      "id": "vn_custom_0020",
      "name": "Sensitive Files — Environment & Config",
      "category": "custom",
      "severity": "medium",
      "action": "block",
      "enable": true,
      "priority": 30,
      "matcher": {
        "URI": {
          "operator": "≈",
          "value": "/(?:\\.env|\\.git(?:/|$)|\\.svn/entries|\\.DS_Store|credentials\\.(?:json|ya?ml|txt|bak|csv|conf|ini|env|pem|key|p12|inc|php)|wp-config\\.php|config\\.php|config\\.inc|web\\.config|appsettings\\.[a-z]+\\.json|\\.npmrc|\\.netrc|\\.pgpass|\\.dockercfg|\\.my\\.cnf|\\.user\\.ini|id_rsa|authorized_keys|ntuser\\.dat|\\.ssh/|\\.aws/|\\.kube/config|\\.docker/config\\.json)|\\.(?:bak|old|save|swp|tar\\.gz|sql\\.gz|htaccess|htpasswd|bash_history|ssh)$"
        }
      },
      "description": "Blocks access to sensitive config, VCS, and backup files (.env, any /.git/ path incl. HEAD/config/index, credentials.*, *.bak/*.old/*.swp/*.tar.gz/*.sql.gz/.htaccess/.htpasswd, etc.). Extension list is deliberately narrow (backup/sensitive suffixes only) so that legitimate downloads (.zip/.yaml/.log/… ) on distribution or docs sites are not blocked.",
