    {
      "id": "vn_deser_0023",
      "name": "Insecure Deserialization — Java/PHP Serialized Payloads",
      "category": "deserialization",
      "severity": "high",
      "action": "log",
      "enable": true,
      "priority": 20,
      "matcher": {
        "Args": {
          "name_operator": "*",
          "operator": "≈",
          "value": "(?:^|[^A-Za-z0-9+/=])rO0AB[A-Za-z0-9+/=]{8,}|\\b(?:O|C):\\d+:\""
        }
      },
      "description": "Detects Java serialized objects (base64 rO0AB magic) and PHP object-injection payloads (O:N:\"...\"). Logged by default; flip to block if the application never accepts serialized data.",
      "tags": [
        "deserialization"
      ],
      "version": 1,
      "created_at": "2026-10-12T06:14:50Z",
      "updated_at": "2026-10-12T06:14:50Z",
