[Unit]
Description=VeryNginx Firewall Helper (nftables kernel IP blocking)
After=network.target firewall-helper.socket
Requires=firewall-helper.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/firewall-helper
Restart=on-failure
RestartSec=1
User=verynginx
Group=verynginx

# Capabilities: CAP_NET_ADMIN is sufficient for nftables manipulation.
# No need for full root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Security hardening: the helper only needs to talk to nginx workers
# and execute '/usr/sbin/nft -f -'.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/run/verynginx
ExecStartPre=/bin/mkdir -p /run/verynginx
# The firewall-helper.socket unit OWNS /run/verynginx + the .sock file.
# Do NOT add RuntimeDirectory= to this service: on every service (re)start
# systemd would wipe the directory, unlinking the socket file and leaving
# the kernel listener unreachable by path -> panel shows helper_unavailable.
# The socket node's group is set by [Socket] SocketGroup=verynginx, so the
# nginx worker (member of verynginx) can connect to the 0660 node.
# Peer auth (helper/peer_linux.go) re-checks SO_PEERCRED beyond the
# filesystem 0660+group: only the helper's own uid, uid 0, or uids in
# VN_HELPER_ALLOWED_UIDS may talk to it. Set this to the nginx worker uid,
# e.g. Environment=VN_HELPER_ALLOWED_UIDS=1001  (install-lnmp.sh does this
# automatically; manual installs must add it, or the panel shows
# helper_unavailable even though the socket is reachable).
#Environment=VN_HELPER_ALLOWED_UIDS=<nginx worker uid>

[Install]
WantedBy=multi-user.target
