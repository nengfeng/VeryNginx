[Unit]
Description=VeryNginx Firewall Helper (nftables kernel IP blocking)
After=network.target
Requires=firewall-helper.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/firewall-helper
Restart=on-failure
RestartSec=1

# Capabilities: CAP_NET_ADMIN is sufficient for nftables manipulation.
# No need for full root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Security hardening: the helper only needs to talk to nginx workers
# and execute '/usr/sbin/nft -f -'.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/run/verynginx
RuntimeDirectory=verynginx

# Ensure the socket directory is accessible
ExecStartPre=/bin/mkdir -p /run/verynginx

[Install]
WantedBy=multi-user.target
