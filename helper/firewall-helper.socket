[Unit]
Description=VeryNginx Firewall Helper Socket
Before=nginx.service

[Socket]
ListenStream=/run/verynginx/firewall-helper.sock
SocketMode=0660
Group=verynginx
# 0750 would make /run/verynginx root:root non-traversable for the nginx
# worker after a reboot (systemd recreates it before nginx starts; the
# installer's manual chmod 755 only masks the first run). Traversal is
# harmless — access control lives on the SOCKET itself (0660+verynginx).
DirectoryMode=0755

[Install]
WantedBy=sockets.target
